# =============================================================================
# Self-Hosted AI Chat - example configuration
#
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Session encryption key. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL connection string.
# The docker compose stack sets this for you; override only if you bring your
# own database.
POSTGRES_URL=postgres://chat:chat@localhost:5432/chat

# -----------------------------------------------------------------------------
# Model provider - set AT LEAST ONE
#
# A provider becomes available simply by having its variables set. Set several
# and you can switch between them in the model picker at runtime. Nothing is
# hardcoded in the application.
# -----------------------------------------------------------------------------

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq - https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vercel AI Gateway - https://vercel.com/ai-gateway
# The upstream template's default, kept as an option.
AI_GATEWAY_API_KEY=

# Any OpenAI-compatible endpoint: Ollama, llama.cpp, vLLM, LM Studio, LiteLLM.
# No API key needed for most local servers.
#
# From inside docker compose, use host.docker.internal to reach a server
# running on the host machine:
#   OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Comma-separated. Required if the endpoint has no /models listing.
#   OPENAI_COMPATIBLE_MODELS=llama3.1:8b,qwen2.5-coder:7b
OPENAI_COMPATIBLE_MODELS=
# Display name for this endpoint in the model picker. Default: "Self-hosted"
OPENAI_COMPATIBLE_LABEL=

# Optional base URL overrides, for proxies or self-hosted gateways.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Model selection (all optional)
#
# Model ids are "provider:model", split on the FIRST colon:
#   anthropic:claude-sonnet-4-5
#   openai:gpt-4.1-mini
#   openrouter:anthropic/claude-3.5-sonnet   (slashes are fine)
#   compatible:llama3.1:8b                   (further colons are fine)
# -----------------------------------------------------------------------------

# Model used for new chats. Defaults to the first model of the first
# configured provider.
DEFAULT_CHAT_MODEL=

# Cheap models for generating chat titles and artifacts.
# Both fall back to DEFAULT_CHAT_MODEL.
TITLE_MODEL=
ARTIFACT_MODEL=

# By default the app asks each configured provider which models it serves, so
# the list never goes stale. Set AI_MODELS to a JSON array to override that
# completely:
#   AI_MODELS='[{"id":"anthropic:claude-sonnet-4-5","name":"Claude Sonnet 4.5"}]'
# Optional per-entry "reasoningTag":"think" surfaces <think>...</think> output
# as reasoning, for DeepSeek-R1-style local models.
AI_MODELS=

# -----------------------------------------------------------------------------
# File attachments (optional)
# -----------------------------------------------------------------------------

# "inline"      - default. Attachments are encoded as data URLs and stored with
#                 the message. No external storage service, works offline and
#                 with every provider. Fine for occasional image attachments;
#                 not what you want if users upload heavily, because the data
#                 then lives in Postgres.
# "vercel-blob" - Vercel Blob. Requires BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER=inline

# Only used when STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Max attachment size in bytes. Default 5 MB.
MAX_UPLOAD_BYTES=

# -----------------------------------------------------------------------------
# Optional extras - all disabled by default
# -----------------------------------------------------------------------------

# Redis. Enables per-IP rate limiting. Without it, rate limiting is off.
REDIS_URL=

# OpenTelemetry export via @vercel/otel. Off by default: no telemetry leaves
# your server unless you ask for it.
ENABLE_OTEL=false

# Vercel BotID bot protection. Only meaningful when deployed on Vercel.
ENABLE_BOTID=false
